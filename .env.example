# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# ── Database ────────────────────────────────────────────────────────────────
# Local dev: matches docker-compose.yml defaults
DATABASE_URL=postgresql+asyncpg://hikecast:hikecast@localhost:5432/hikecast
# Production: paste the provider's connection string as-is. A libpq URL
# (postgresql://…?sslmode=require, which is what Neon hands you) is normalized
# automatically — the driver is switched to asyncpg and sslmode is translated
# into a TLS connect argument. See app/core/config.py.

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 bytes — pyjwt warns on shorter secrets.
JWT_SECRET=change_me_before_deploying
JWT_LIFETIME_SECONDS=900
REFRESH_LIFETIME_SECONDS=2592000
COOKIE_SECURE=false   # set to true in production (requires HTTPS)

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins.
# In production the browser only ever calls the Vercel domain, which proxies
# /api/* to the backend (frontend/vercel.json) — so requests arrive same-origin
# and CORS is not what makes auth work. Keep the frontend origin listed anyway
# for direct API calls and clear errors: CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# ── Open-Meteo (no API key needed — free tier, CC BY 4.0) ──────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1
OPEN_METEO_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1

# ── Cache ───────────────────────────────────────────────────────────────────
FORECAST_CACHE_TTL_MINUTES=30
CLIMATOLOGY_YEARS=10

# ── AI (optional) ───────────────────────────────────────────────────────────
# Get a key at https://platform.claude.com — leave empty to disable AI features
# (the packing-advice endpoint returns 503 and the UI hides the button).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Frontend (Vite reads VITE_ prefixed vars) ───────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
