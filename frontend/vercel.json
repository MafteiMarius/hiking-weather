{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hikecast-api.onrender.com/api/:path*"
    },
    {
      "source": "/upstream/open-meteo/:path*",
      "destination": "https://api.open-meteo.com/:path*"
    },
    {
      "source": "/upstream/open-meteo-archive/:path*",
      "destination": "https://archive-api.open-meteo.com/:path*"
    },
    {
      "source": "/upstream/open-meteo-geocode/:path*",
      "destination": "https://geocoding-api.open-meteo.com/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
